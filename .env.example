# ─────────────────────────────────────────────────────────────
#  SIX Wowness Club — variáveis de ambiente
#  Copie para .env.local (dev) e configure na Vercel (produção).
# ─────────────────────────────────────────────────────────────

# URL do projeto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave anônima pública (Project Settings → API → anon public)
# Usada no navegador para leitura do cardápio e realtime.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave service_role SECRETA (Project Settings → API → service_role)
# NUNCA exponha no cliente. Usada apenas em Server Actions / rotas server.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL pública de produção — usada pelo gerador de QR (/qr).
# Ex.: https://bar-six.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
